#!/usr/bin/env bash
set -euo pipefail

publish_log=$(mktemp)
trap 'rm -f "$publish_log"' EXIT

# Publish dependencies first so a partially completed release can be resumed.
for package in \
  mhr-gpui-kit-assets \
  mhr-gpui-kit-component-macros \
  mhr-gpui-kit-base \
  mhr-gpui-kit-writing \
  mhr-gpui-kit-component \
  mhr-gpui-kit
do
  # CI forces colored Cargo output; keep diagnostics plain for matching below.
  if cargo publish -p "$package" --color never 2>&1 | tee "$publish_log"; then
    continue
  else
    publish_status=$?
  fi

  if grep -Eq "^error: crate ${package}@[0-9][^ ]* already exists on crates.io index$" "$publish_log"; then
    echo "::notice::Skipping already published crate: $package"
  else
    exit "$publish_status"
  fi
done
