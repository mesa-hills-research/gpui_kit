[package]
name = "{{crate_name}}"
version = "0.1.0"
description = "{{display_name}}"
edition = "2024"
publish = false

[dependencies]
# GPUI Kit from Mesa Hills Research's fork. It pins the matching gpui-pre release
# and re-exports it, so GPUI is `gpui_kit::*` and needs no entry of its own.
gpui-kit = { git = "https://github.com/mesa-hills-research/gpui_kit", {{kit_ref}} }
tracing = "0.1"
tracing-subscriber = { version = "0.3", features = ["env-filter"] }

[build-dependencies]
winresource = "0.1"

# GPUI from Mesa Hills Research's fork, at the commit GPUI Kit builds with. Cargo applies
# only the app's own patches, so the kit's patch doesn't reach the app.
[patch.crates-io]
gpui-pre                   = { git = "https://github.com/mesa-hills-research/gpui", {{gpui_ref}} }
gpui-pre-apple             = { git = "https://github.com/mesa-hills-research/gpui", {{gpui_ref}} }
gpui-pre-collections       = { git = "https://github.com/mesa-hills-research/gpui", {{gpui_ref}} }
gpui-pre-derive-refineable = { git = "https://github.com/mesa-hills-research/gpui", {{gpui_ref}} }
gpui-pre-http-client       = { git = "https://github.com/mesa-hills-research/gpui", {{gpui_ref}} }
gpui-pre-linux             = { git = "https://github.com/mesa-hills-research/gpui", {{gpui_ref}} }
gpui-pre-macos             = { git = "https://github.com/mesa-hills-research/gpui", {{gpui_ref}} }
gpui-pre-macros            = { git = "https://github.com/mesa-hills-research/gpui", {{gpui_ref}} }
gpui-pre-perf              = { git = "https://github.com/mesa-hills-research/gpui", {{gpui_ref}} }
gpui-pre-platform          = { git = "https://github.com/mesa-hills-research/gpui", {{gpui_ref}} }
gpui-pre-refineable        = { git = "https://github.com/mesa-hills-research/gpui", {{gpui_ref}} }
gpui-pre-scheduler         = { git = "https://github.com/mesa-hills-research/gpui", {{gpui_ref}} }
gpui-pre-shared-string     = { git = "https://github.com/mesa-hills-research/gpui", {{gpui_ref}} }
gpui-pre-sum-tree          = { git = "https://github.com/mesa-hills-research/gpui", {{gpui_ref}} }
gpui-pre-util              = { git = "https://github.com/mesa-hills-research/gpui", {{gpui_ref}} }
gpui-pre-util-macros       = { git = "https://github.com/mesa-hills-research/gpui", {{gpui_ref}} }
gpui-pre-web               = { git = "https://github.com/mesa-hills-research/gpui", {{gpui_ref}} }
gpui-pre-wgpu              = { git = "https://github.com/mesa-hills-research/gpui", {{gpui_ref}} }
gpui-pre-windows           = { git = "https://github.com/mesa-hills-research/gpui", {{gpui_ref}} }
gpui-pre-zlog              = { git = "https://github.com/mesa-hills-research/gpui", {{gpui_ref}} }
gpui-pre-ztracing          = { git = "https://github.com/mesa-hills-research/gpui", {{gpui_ref}} }
gpui-pre-ztracing-macro    = { git = "https://github.com/mesa-hills-research/gpui", {{gpui_ref}} }

[profile.release]
codegen-units = 1
lto = "thin"

# GPUI's layout, text and drawing crates are slow unoptimized. Optimizing them
# keeps debug builds responsive while the app's own code stays quick to build.
[profile.dev.package]
gpui-pre = { opt-level = 3 }
gpui-pre-sum-tree = { opt-level = 3 }
resvg = { opt-level = 3 }
ropey = { opt-level = 3 }
rustybuzz = { opt-level = 3 }
taffy = { opt-level = 3 }
ttf-parser = { opt-level = 3 }
